Algoritmo "procedimento_soma"

Var

   x, y: inteiro

procedimento soma(a, b: inteiro)

inicio

      escreval("Recebi o valor, ", a)
      escreval("Recebi o vlor, ", b)
      escreval("A soma entre ", a, " e ", b, "é ", a + b)

fimprocedimento



Inicio

   x <- 3
   y <- 5
   soma(x, y)



Fimalgoritmo