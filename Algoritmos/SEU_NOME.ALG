algoritmo "Seu_Nome"


Var

   nome: caractere
   idade: inteiro

inicio

      escreval("Olá, escreva seu nome, por favor.")
      leia(nome)
      escreval("Olá ", nome, "Muito prazer em te conhecer")
      escreval("Agora escreva a sua idade, por favor. ")
      leia(idade)
      escreva("Uau, além de um nome bonito, ainda por cima é jovem!!!")

fimalgoritmo