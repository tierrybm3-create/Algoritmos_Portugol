Algoritmo "disney"

Var

   cash: real


Inicio

      escreva("Quanto de dinheiro você tem? ")
      leia(cash)
      
      Se (cash >= 10000) então
         escreva("Ebaaa! Com esse dinheiro você pode ir a Disney!")
         
      Senão (cash < 10000) então
            escreva("Que triste, com esse dinheiro não se pode ir a Disney")
      
      FimSe


Fimalgoritmo